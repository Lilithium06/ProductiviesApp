<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ProductiviesApp"
             x:Class="ProductiviesApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#fe6c67</Color>
            <Color x:Key="Secondary">#01a03a</Color>
            <Color x:Key="Accent">#29f4fe</Color>
            <Color x:Key="Background">#130600</Color>
            <Color x:Key="Surface">#1d0e0d</Color>
            <Color x:Key="Text">#ffe1df</Color>
            <Color x:Key="TextSecondary">#877265</Color>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>